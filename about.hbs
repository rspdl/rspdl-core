<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>RSPDL third-party licenses</title>
  <style>
    body { font-family: sans-serif; line-height: 1.5; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { background: #f5f5f5; overflow: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>RSPDL third-party licenses</h1>
  <p>This file is generated from the Cargo dependency graph. RSPDL itself is licensed under Apache-2.0.</p>
  {{#each licenses}}
  <section>
    <h2>{{name}} ({{id}})</h2>
    <p>Used by:
      {{#each used_by}}
      <code>{{crate.name}} {{crate.version}}</code>{{#unless @last}}, {{/unless}}
      {{/each}}
    </p>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
