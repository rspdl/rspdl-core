# Pre-mutation field producer.  A condition is deliberately restricted to the
# direct enum decision shape used by creation branches.
pub field_producer_statement =
    producer_name: @surface_name() producer_id: @canonical_id() ("은" | "는")
    (
        action: @marked_ref("이", "가") "실행될" "때"
      | conditional_action: @marked_ref("의") condition_input: @marked_ref("이", "가") condition_variant: @marked_ref("이면", "라면")
    )
    (
        input: @source_direct("을", "를")
      | existing_input: @marked_ref("의") existing_field: @marked_ref("을", "를")
      | "상수" constant: @literal("을", "를")
    )
    output_model: @marked_ref("의") output_field: @marked_ref("으로", "로")
    "기록한다" "." ;
